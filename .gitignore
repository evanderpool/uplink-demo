__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local indexes are never committed - they may contain private corpus content.
data/
*.db
*.db-wal
*.db-shm

# Generated reports contain corpus content - the capability is public,
# your outputs are not.
reports/

# Fetched test corpora - re-download with scripts/fetch_corpora.py.
corpora/

# Apple product manuals fetched for local indexing — Apple's copyright,
# personal use only, never redistributed. (corpora/ already covers this;
# stated explicitly so the intent survives a future .gitignore edit.)
corpora/apple-products/

# Fixtures scoring a PRIVATE corpus stay local: they reference documents
# nobody else has, and naming them publicly serves no one.
fixtures/local-*.jsonl
